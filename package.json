{
  "name": "spirit-island-online",
  "version": "0.1.0",
  "description": "정령섬(Spirit Island)·아르낙 스타일 탐험 보드게임을 친구와 함께 브라우저에서 플레이하는 온라인 멀티플레이 구현",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "play": "node server/index.js --open",
    "dev": "node --watch server/index.js",
    "share": "npx -y cloudflared tunnel --url http://localhost:3000",
    "icons": "node scripts/make-icons.js",
    "test": "node --test test/*.test.js arnak/test/*.test.js champions/test/*.test.js keepout/test/*.test.js",
    "test:e2e:save": "node test/e2e-save.js",
    "test:e2e": "node test/e2e.js",
    "arnak": "node arnak/server/index.js",
    "arnak:play": "node arnak/server/index.js --open",
    "share:arnak": "npx -y cloudflared tunnel --url http://localhost:3100",
    "test:e2e:arnak": "node arnak/test/e2e.js",
    "champions": "node champions/server/index.js",
    "champions:play": "node champions/server/index.js --open",
    "share:champions": "npx -y cloudflared tunnel --url http://localhost:3200",
    "test:e2e:champions": "node champions/test/e2e.js",
    "keepout": "node keepout/server/index.js",
    "keepout:play": "node keepout/server/index.js --open",
    "share:keepout": "npx -y cloudflared tunnel --url http://localhost:3300",
    "test:e2e:keepout": "node keepout/test/e2e.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "three": "^0.169.0",
    "ws": "^8.18.0"
  }
}
